{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Picflow Library",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "noEmit": false,
    "outDir": "dist"
  }
}
