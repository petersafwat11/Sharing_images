# =============================================================================
# Picflow — Environment Variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://picflow:picflow@localhost:5432/picflow

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# next-auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AWS S3 (active storage backend — will migrate to Cloudflare R2 later)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# -----------------------------------------------------------------------------
# Cloudflare R2 (reserved for future migration — leave blank until needed)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL used to serve uploaded objects (e.g. https://cdn.picflow.app)
R2_PUBLIC_URL=
# https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=

# -----------------------------------------------------------------------------
# Replicate (AI portrait generation)
# -----------------------------------------------------------------------------
# Get token at https://replicate.com/account
REPLICATE_API_TOKEN=
# Random secret appended to webhook URL — generate with: openssl rand -hex 32
REPLICATE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (email notifications)
# -----------------------------------------------------------------------------
# Get API key at https://resend.com
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret from Stripe Dashboard → Webhooks → your endpoint
# Listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Public key exposed to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Phase 4 — Admin + Print
# -----------------------------------------------------------------------------
# cuid of the admin user — leave blank to allow any logged-in user access in dev
ADMIN_USER_ID=
# Get API key at https://dashboard.gelato.com
GELATO_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
